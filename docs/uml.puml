@startuml
!pragma layout smetana
title Strategy Pattern - Calculator

skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam nodesep 65
skinparam ranksep 70
hide circle

class Main <<Client>> {
    {static} + main(args: String[]): void
}

class ExtensionDemo <<Client>> {
    {static} + main(args: String[]): void
}

class Calculator <<Context>> {
    - strategy: OperationStrategy
    + Calculator(strategy: OperationStrategy)
    + setStrategy(strategy: OperationStrategy): void
    + calculate(left: double, right: double): double
}

interface OperationStrategy <<Strategy>> {
    + execute(left: double, right: double): double
}

class AddStrategy <<ConcreteStrategy>> {
    + execute(left: double, right: double): double
}

class SubtractStrategy <<ConcreteStrategy>> {
    + execute(left: double, right: double): double
}

class MultiplyStrategy <<ConcreteStrategy>> {
    + execute(left: double, right: double): double
}

class DivideStrategy <<ConcreteStrategy>> {
    + execute(left: double, right: double): double
}

Main ..> Calculator : uses / configures
ExtensionDemo ..> Calculator : uses / configures
Calculator --> "1" OperationStrategy : delegates to

Main ..> AddStrategy : creates
Main ..> SubtractStrategy : creates
Main ..> MultiplyStrategy : creates
ExtensionDemo ..> AddStrategy : creates
ExtensionDemo ..> DivideStrategy : creates

AddStrategy ..|> OperationStrategy : implements
SubtractStrategy ..|> OperationStrategy : implements
MultiplyStrategy ..|> OperationStrategy : implements
DivideStrategy ..|> OperationStrategy : implements

@enduml
